.coverage
htmlcov/
*.sqlite3
eco_echo.db

# Node & frontend build caches
client/node_modules/
client/.vite/
client/dist/

# IDE & agent artifacts
.gemini/
.agent/
.agents/
.gsd/
scratch/
*.log

# OS artifacts
.DS_Store
Thumbs.db
