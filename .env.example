# ECO-ECHO Environment Configuration Template
# Copy this file to .env and adjust variables as needed.

# Application Environment (development | staging | production)
ENVIRONMENT=development
DEBUG=false

# Persistence
DATABASE_URL=sqlite:///./eco_echo.db

# API & Server
API_HOST=127.0.0.1
API_PORT=8000
VITE_API_BASE=http://localhost:8000/api

# Security & CORS (Comma-separated trusted origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# AWS Cloud Integrations (OPTIONAL: ECO-ECHO functions 100% locally without cloud credentials)
USE_AWS_BEDROCK=false
USE_AWS_S3=false
AWS_REGION=ap-south-1
AWS_S3_BUCKET=eco-echo-sustainability-data-2026
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# AWS Credentials (OPTIONAL: If authenticated via AWS CLI v2 or ~/.aws/credentials, leave these empty. The AWS SDK standard provider chain will automatically discover your credentials.)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
# AWS_SESSION_TOKEN=
# AWS_PROFILE=default

