# ==============================================================================
# ECO-ECHO Frontend Production Environment Configuration (AWS)
# ==============================================================================

# Option 1: Unified Amazon CloudFront (RECOMMENDED)
# CloudFront serves static assets from S3 on /* and routes /api/* to the backend.
# This gives you a single origin, free SSL, and completely eliminates CORS issues.
VITE_API_URL=/api

# Option 2: Dedicated Backend URL (AWS App Runner or ALB)
# If your backend runs as a separate App Runner or ALB service without unified CloudFront:
# VITE_API_URL=https://<your-service-id>.ap-south-1.awsapprunner.com
